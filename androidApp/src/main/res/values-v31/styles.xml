<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Dsh" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dsh_background_light</item>
        <item name="android:statusBarColor">@color/dsh_background_light</item>
        <item name="android:navigationBarColor">@color/dsh_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowSplashScreenBackground">@color/dsh_background_light</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/dsh_background_light</item>
    </style>
</resources>
